# Runtime server variable. In Railway use http://${{backend.RAILWAY_PRIVATE_DOMAIN}}:8000
BACKEND_URL=http://localhost:8000
# Optional fallback backend origin when BACKEND_URL is not set.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Shared secret authenticating client-IP headers forwarded to the backend on Railway.
TRUSTED_PROXY_KEY=
# Optional server-side beta key: never use NEXT_PUBLIC_BETA_KEY for a secret.
BETA_KEY=
# Public SEO settings are build-time values for Docker.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_VERIFICATION=
