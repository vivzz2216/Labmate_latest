# Local development example. For production use the Railway guide.
DATABASE_URL=postgresql://labmate:labmate_password@localhost:5432/labmate_db
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
BETA_KEY=
ALLOWED_ORIGINS=http://localhost:3000
DATA_DIR=./data
WORKFLOW_WORKERS=2
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=true
RATE_LIMIT_ENABLED=false
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_MAX_COMPLETION_TOKENS=12000
GROQ_REASONING_EFFORT=low
LLM_FALLBACK_PROVIDER=gemini
FREE_LLM_FALLBACK_ORDER=openrouter,opencode
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_REASONING_EFFORT=low
# Enable only when OpenCode permits external app access; probe returned 403.
OPENCODE_ENABLED=false
OPENCODE_API_KEY=
OPENCODE_MODEL=big-pickle
FREE_LLM_REQUEST_TIMEOUT=60
FREE_LLM_MAX_TOKENS=12000

# Optional metered fallback after free routes. Keep its key on the backend only.
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REQUEST_TIMEOUT=90
DEEPSEEK_MAX_TOKENS=12000

# AWT/Swing need a desktop-capable JDK; Linux also needs xvfb-run and xauth.
# Windows creates a private inactive desktop, without reading the user's screen.
JAVA_GUI_TEST_TIMEOUT=30
JAVA_GUI_TOTAL_TIMEOUT=90
GEMINI_API_KEY=
# On Railway code execution stays closed until invited accounts are configured.
# This is admission control; the process runner is suitable for trusted beta users only.
EXECUTION_ALLOWED_EMAILS=

# Optional operator login, provisioned at startup. Keep both values server-only.
# The configured operator skips student onboarding and has unlimited platform credits.
ADMIN_USERID=
ADMIN_PASSWORD=
# Other credit-exempt accounts still need admission through EXECUTION_ALLOWED_EMAILS.
# This does not increase upstream AI provider quotas.
CREDIT_EXEMPT_EMAILS=

# Optional one-time experiment packs. Keep secrets on the backend only.
BILLING_ENABLED=false
BILLING_TRIAL_CREDITS=3
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
