# Local development example. For production use the Railway guide.
DATABASE_URL=postgresql://labmate:labmate_password@localhost:5432/labmate_db
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
BETA_KEY=
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
DATA_DIR=./data
# Object storage backend ("local" or "s3" / Cloudflare R2).
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=labmate-storage
S3_REGION_NAME=auto
S3_PUBLIC_URL_PREFIX=
WORKFLOW_WORKERS=2
REDIS_URL=redis://localhost:6379/0
REDIS_REQUIRED=true
RATE_LIMIT_ENABLED=true
EXECUTION_ISOLATION=required
EXECUTION_BACKEND=ssh
# Grants only named test accounts the password exception and beta execution access.
BETA_TEST_EMAILS=
# Railway-only option: EXECUTION_BACKEND=railway_sandbox.
# Set RAILWAY_API_TOKEN in the backend service environment only; never NEXT_PUBLIC_*.
RAILWAY_SANDBOX_ENVIRONMENT_ID=
RAILWAY_SANDBOX_TIMEOUT=480
RAILWAY_SANDBOX_HEALTH_TTL=300
# Dedicated Linux VM; no Docker daemon is needed. See docs/ISOLATED_RUNTIME.md.
SANDBOX_SSH_HOST=
SANDBOX_SSH_PORT=22
SANDBOX_SSH_USER=labmate
SANDBOX_SSH_KEY=
SANDBOX_KNOWN_HOSTS=
WORKER_HEALTH_TIMEOUT=10
WORKER_HEALTH_TTL=15
# Concurrent sandbox runs / screenshot browsers per process. Keep 1 for a single SSH worker or a laptop.
# For 100 students with EXECUTION_BACKEND=railway_sandbox, on each WORKFLOW_WORKERS=25 worker:
#   HEAVY_EXECUTION_LOCAL_LIMIT=25  HEAVY_EXECUTION_GLOBAL_LIMIT=90  (Railway Pro allows 100 sandboxes)
#   BROWSER_CAPTURE_LOCAL_LIMIT=4   (about 0.4 GB of RAM each; give the worker 8 GB)
# GLOBAL limits are enforced through Redis across all replicas; 0 turns the shared cap off.
HEAVY_EXECUTION_LOCAL_LIMIT=1
HEAVY_EXECUTION_GLOBAL_LIMIT=0
BROWSER_CAPTURE_LOCAL_LIMIT=1
BROWSER_CAPTURE_GLOBAL_LIMIT=0
# Separate workflow-worker service (see RAILWAY.md): LABMATE_ROLE=worker runs consumers only.
# Set WORKFLOW_WORKERS=0 on the API service. Requires STORAGE_BACKEND=s3 so workers can read uploads.
# LABMATE_ROLE=worker
# Postgres connections kept per process; raised automatically to WORKFLOW_WORKERS + 3 if smaller.
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5
TRUSTED_PROXY_KEY=
# Anonymous and invalid-token requests are limited per IP. Signed-in requests are limited per
# user, so a campus behind one public address does not share a bucket; the IP ceiling bounds
# many accounts behind one address (0 disables it). Login, signup and refresh stay per IP.
RATE_LIMIT_PER_MINUTE=180
USER_RATE_LIMIT_PER_MINUTE=180
AUTHENTICATED_IP_RATE_LIMIT_PER_MINUTE=3000
AUTH_RATE_LIMIT_PER_MINUTE=20
LLM_PROVIDER=glm
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=
GROQ_MAX_COMPLETION_TOKENS=12000
GROQ_REASONING_EFFORT=low
LLM_FALLBACK_PROVIDER=none
FREE_LLM_FALLBACK_ORDER=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_REASONING_EFFORT=low
# Enable only when OpenCode permits external app access; probe returned 403.
OPENCODE_ENABLED=false
OPENCODE_API_KEY=
OPENCODE_MODEL=big-pickle
FREE_LLM_REQUEST_TIMEOUT=60
FREE_LLM_MAX_TOKENS=12000

# Optional metered fallback after free routes. Keep its key on the backend only.
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_REQUEST_TIMEOUT=90
DEEPSEEK_MAX_TOKENS=12000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4000
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
CLAUDE_MAX_TOKENS=2000
CLAUDE_REQUEST_TIMEOUT=45
GLM_ENABLED=true
GLM_API_KEY=
GLM_MODEL=glm-5.3-flash
GLM_ENDPOINT=https://api.z.ai/api/paas/v4/chat/completions
GLM_REASONING_EFFORT=low
GLM_REQUEST_TIMEOUT=90
GLM_MAX_TOKENS=12000

# AWT/Swing need a desktop-capable JDK; Linux also needs xvfb-run and xauth.
# Windows creates a private inactive desktop, without reading the user's screen.
JAVA_GUI_TEST_TIMEOUT=30
JAVA_GUI_TOTAL_TIMEOUT=90
# On Railway code execution stays closed until invited accounts are configured.
# This is admission control; the process runner is suitable for trusted beta users only.
EXECUTION_ALLOWED_EMAILS=
# Local development only: allow active signed-in students with complete profiles.
# Has no effect on Railway and does not disable isolated execution.
LOCAL_OPEN_EXECUTION=false

# Optional operator login, provisioned at startup. Keep both values server-only.
# The configured operator skips student onboarding and has unlimited platform credits.
ADMIN_USERID=
ADMIN_PASSWORD=
# Other credit-exempt accounts still need admission through EXECUTION_ALLOWED_EMAILS.
# This does not increase upstream AI provider quotas.
CREDIT_EXEMPT_EMAILS=

# Optional one-time experiment packs. Keep secrets on the backend only.
BILLING_ENABLED=false
BILLING_TRIAL_CREDITS=3
RAZORPAY_MODE=test
RAZORPAY_PAYMENT_CHECK_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# MySQL SQL-Lab Runtime (isolated per-run schema & restricted credentials)
MYSQL_URL=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ADMIN_USER=root
MYSQL_ADMIN_PASSWORD=
MYSQL_QUERY_TIMEOUT=5.0
MYSQL_MAX_ROWS=1000

# Dedicated Ubuntu VM; keep SSH identities server-side. Never expose VNC publicly.
UBUNTU_SSH_HOST=
UBUNTU_SSH_PORT=22
UBUNTU_SSH_USER=labmate
UBUNTU_SSH_KEY=
UBUNTU_KNOWN_HOSTS=
